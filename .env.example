DOCTOR_EMAIL=
DOCTOR_PHONE=+91XXXXXXXXXX
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=               # Gmail app password
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=             # Twilio SMS number
